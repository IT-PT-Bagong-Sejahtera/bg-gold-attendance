APP_ENV=development
HTTP_ADDR=:8080

MYSQL_DATABASE=bg_gold_attendance
MYSQL_USER=bg_gold
MYSQL_PASSWORD=replace-with-a-random-development-database-secret
MYSQL_ROOT_PASSWORD=replace-with-a-random-development-root-secret
MYSQL_DSN=bg_gold:replace-with-a-random-development-database-secret@tcp(mysql:3306)/bg_gold_attendance?parseTime=true&multiStatements=true&charset=utf8mb4

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
DYNAMIC_QR_SECRET=replace-with-a-different-32-byte-random-signing-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:5173

MINIO_ACCESS_KEY=bg_gold_minio
MINIO_SECRET_KEY=replace-with-a-random-development-secret
MINIO_BUCKET=attendance-evidence

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=attendance@bggold.local
SMTP_FROM_NAME=BG GOLD Attendance
SMTP_REQUIRE_TLS=false
PASSWORD_RESET_URL=bggold-attendance://reset-password

# Optional integrations
OCR_ENDPOINT=
OCR_API_KEY=
OCR_TIMEOUT=10s
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
PLAY_INTEGRITY_PACKAGE_NAME=com.bggold.attendance
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# Host ports can be changed when another local service already uses them.
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307
MINIO_API_BIND_ADDRESS=127.0.0.1
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
API_BIND_ADDRESS=0.0.0.0
API_HOST_PORT=8080

# Local seed only; use a password with at least 12 characters.
SEED_ADMIN_EMAIL=admin@bggold.local
SEED_ADMIN_PASSWORD=replace-with-a-local-seed-password
