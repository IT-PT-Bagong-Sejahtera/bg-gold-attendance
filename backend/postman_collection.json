{
  "info": {
    "name": "Absen BG Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "shiftId", "value": "" },
    { "key": "sectionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"superadmin@bggold.local\",\n  \"password\": \"change-me\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "My Shifts",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/me/shifts"
      }
    },
    {
      "name": "Clock In",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "postman-clock-in-001" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"type\": \"CLOCK_IN\",\n  \"shiftId\": \"{{shiftId}}\",\n  \"sectionId\": \"{{sectionId}}\",\n  \"evidence\": {}\n}" },
        "url": "{{baseUrl}}/api/v1/attendance/actions"
      }
    },
    {
      "name": "Attendance History",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/me/attendance/history"
      }
    }
  ]
}
