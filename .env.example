APP_ENV=development
HTTP_ADDR=:8080
MYSQL_DSN=bg_gold:replace-with-a-random-development-database-secret@tcp(mysql:3306)/bg_gold_attendance?parseTime=true&multiStatements=true&charset=utf8mb4
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
DYNAMIC_QR_SECRET=replace-with-a-different-32-byte-random-signing-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:5173

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=bg_gold_minio
MINIO_SECRET_KEY=replace-with-a-random-development-secret
MINIO_BUCKET=attendance-evidence
MINIO_USE_SSL=false

# Optional provider-neutral receipt OCR gateway. It receives a short-lived
# private object URL and returns structured merchant/total/date evidence.
OCR_ENDPOINT=
OCR_API_KEY=
OCR_TIMEOUT=10s

# Production email delivery. Local Compose defaults to Mailpit on port 1025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=attendance@bggold.local
SMTP_FROM_NAME=BG GOLD Attendance
SMTP_REQUIRE_TLS=false
PASSWORD_RESET_URL=bggold-attendance://reset-password

# Optional FCM HTTP v1. Mount the service-account JSON into the API container
# and set the in-container path here. Both values must be set together.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Optional Google Play Integrity. The service account must have Play Integrity
# decode access. Mount the JSON into the API container when enabled.
PLAY_INTEGRITY_PACKAGE_NAME=com.bggold.attendance
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=
# Mobile Android build-time value (numeric Google Cloud project number).
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=

MYSQL_DATABASE=bg_gold_attendance
MYSQL_USER=bg_gold
MYSQL_PASSWORD=replace-with-a-random-development-database-secret
MYSQL_ROOT_PASSWORD=replace-with-a-random-development-root-secret

VITE_API_URL=https://attendanceapi.bggold.cloud/api/v1
EXPO_PUBLIC_API_URL=https://attendanceapi.bggold.cloud/api/v1
# Optional host-port overrides (container ports stay unchanged).
MYSQL_HOST_PORT=3307
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
API_HOST_PORT=8080
ADMIN_HOST_PORT=5173
METRO_HOST_PORT=8081
# Local path consumed by Expo prebuild; never commit the Firebase file.
GOOGLE_SERVICES_JSON=

# Optional local seed command. Do not use these values in production.
SEED_SUPERADMIN_EMAIL=superadmin@bggold.local
SEED_SUPERADMIN_PASSWORD=
